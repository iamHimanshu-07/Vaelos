async function driverAssignedToVehicle(user, vehicle_id) {
  if (!user || !user.driver_id) return false;
  const res = await pool.query(
    `SELECT id FROM trips
     WHERE vehicle_id=$1 AND driver_id=$2 AND status IN ('Dispatched','Completed')
     ORDER BY id DESC LIMIT 1`,
    [vehicle_id, user.driver_id]
  );
  return res.rows.length > 0;
}

// ============================== ANALYTICS ============================== //
async function dashboardKpis(viewerEmail) {
  const f = demoFilter(viewerEmail);
  const fWhere = f.where;
  const fArgs = f.args;
  const get = async (sql, ...args) => {
    const res = await pool.query(sql, [...fArgs, ...args]);
    return parseInt(res.rows[0].c);
  };

  const total = await get(`SELECT COUNT(*) c FROM vehicles WHERE ${fWhere}`);
  const activeV = await get(`SELECT COUNT(*) c FROM vehicles WHERE ${fWhere} AND status='On Trip'`);
  const availableV = await get(`SELECT COUNT(*) c FROM vehicles WHERE ${fWhere} AND status='Available'`);
  const inShop = await get(`SELECT COUNT(*) c FROM vehicles WHERE ${fWhere} AND status='In Shop'`);
  const activeT = await get(`SELECT COUNT(*) c FROM trips WHERE ${fWhere} AND status='Dispatched'`);
  const pendingT = await get(`SELECT COUNT(*) c FROM trips WHERE ${fWhere} AND status='Draft'`);
  const onDuty = await get(`SELECT COUNT(*) c FROM drivers WHERE ${fWhere} AND status='On Trip'`);

  return {
    active_vehicles: activeV,
    available_vehicles: availableV,
    in_shop: inShop,
    active_trips: activeT,
    pending_trips: pendingT,
    drivers_on_duty: onDuty,
    fleet_utilization: total ? +((activeV / total) * 100).toFixed(1) : 0,
    total_vehicles: total,
  };
}

async function vehicleMetrics(viewerEmail) {
  const f = demoFilter(viewerEmail);
  const res = await pool.query(`SELECT * FROM vehicles WHERE ${f.where}`, f.args);
  const vehicles = res.rows;

  const results = [];
  for (const v of vehicles) {
    const fuelRes = await pool.query(`SELECT COALESCE(SUM(cost),0) c FROM fuel_logs WHERE ${f.where} AND vehicle_id=$1`, [...f.args, v.id]);
    const maintRes = await pool.query(`SELECT COALESCE(SUM(cost),0) c FROM maintenance WHERE ${f.where} AND vehicle_id=$1`, [...f.args, v.id]);
    const miscRes = await pool.query(`SELECT COALESCE(SUM(amount),0) c FROM expenses WHERE ${f.where} AND vehicle_id=$1`, [...f.args, v.id]);
    const distRes = await pool.query(
      `SELECT COALESCE(SUM(end_odometer-start_odometer),0) d
       FROM trips WHERE ${f.where} AND vehicle_id=$1 AND status='Completed'`,
      [...f.args, v.id]
    );
    const fuelLitRes = await pool.query(`SELECT COALESCE(SUM(liters),0) l FROM fuel_logs WHERE ${f.where} AND vehicle_id=$1`, [...f.args, v.id]);
    const revRes = await pool.query(
      `SELECT COALESCE(SUM(revenue),0) r FROM trips WHERE ${f.where} AND vehicle_id=$1 AND status='Completed'`,
      [...f.args, v.id]
    );

    const fuel = fuelRes.rows[0].c;
    const maint = maintRes.rows[0].c;
    const misc = miscRes.rows[0].c;
    const distance = distRes.rows[0].d;
    const fuel_liters = fuelLitRes.rows[0].l;
    const revenue = revRes.rows[0].r;
    const opCost = fuel + maint + misc;
    const eff = fuel_liters ? distance / fuel_liters : 0;
    const roi = v.acquisition_cost > 0
      ? ((revenue - (maint + fuel)) / v.acquisition_cost) * 100
      : 0;

    results.push({
      id: v.id, reg_no: v.reg_no, name: v.name, type: v.type, status: v.status,
      acquisition_cost: v.acquisition_cost, distance_km: distance,
      fuel_liters, fuel_efficiency: +eff.toFixed(2),
      fuel_cost: fuel, maintenance_cost: maint, misc_cost: misc,
      operational_cost: opCost, revenue, roi_pct: +roi.toFixed(2),
    });
  }
  return results;
}

