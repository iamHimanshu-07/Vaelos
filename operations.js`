async function listMaintenance(vid = null, viewerEmail) {
  const f = demoFilter(viewerEmail, 'm');
  let q = `SELECT m.*, v.reg_no AS vehicle_reg, v.name AS vehicle_name
           FROM maintenance m JOIN vehicles v ON v.id = m.vehicle_id WHERE ${f.where}`;
  const args = [...f.args];
  if (vid) { q += ' AND m.vehicle_id = $'+(args.length+1); args.push(vid); }
  q += ' ORDER BY m.id DESC';
  const res = await pool.query(q, args);
  return res.rows;
}
async function createMaintenance(ctx, { vehicle_id, description, cost, notes }) {
  const client = await pool.connect();
  try {
    await client.query('BEGIN');
    const res = await client.query(
      `INSERT INTO maintenance
       (vehicle_id,description,cost,start_date,status,notes,created_at)
       VALUES ($1,$2,$3,$4,'Open',$5,$6) RETURNING id`,
      [vehicle_id, description.trim(), +cost, new Date().toISOString().slice(0, 10), notes || '', now()]
    );
    const mid = res.rows[0].id;
    await client.query(`UPDATE vehicles SET status='In Shop' WHERE id=$1`, [vehicle_id]);
    await client.query('COMMIT');
    const v = await getVehicle(vehicle_id);
    await audit(ctx, 'maintenance', mid, 'create', `${v?.reg_no}: ${description} (₹${cost})`);
    return [true, 'Maintenance record created. Vehicle moved to In Shop.'];
  } catch (e) {
    await client.query('ROLLBACK');
    throw e;
  } finally {
    client.release();
  }
}
async function closeMaintenance(ctx, mid) {
  const res = await pool.query('SELECT * FROM maintenance WHERE id = $1', [mid]);
  const r = res.rows[0];
  if (!r) return [false, 'Maintenance record not found.'];
  const client = await pool.connect();
  try {
    await client.query('BEGIN');
    await client.query(`UPDATE maintenance SET status='Closed', end_date=$1 WHERE id=$2`, [new Date().toISOString().slice(0, 10), mid]);
    const v = await getVehicle(r.vehicle_id);
    if (v && v.status === 'In Shop')
      await client.query(`UPDATE vehicles SET status='Available' WHERE id=$1`, [r.vehicle_id]);
    await client.query('COMMIT');
  } catch (e) {
    await client.query('ROLLBACK');
    throw e;
  } finally {
    client.release();
  }
  await audit(ctx, 'maintenance', mid, 'close', `Closed maintenance #${mid}`);
  return [true, 'Maintenance closed. Vehicle restored to Available.'];
}
async function deleteMaintenance(ctx, mid) {
  await pool.query('DELETE FROM maintenance WHERE id = $1', [mid]);
  await audit(ctx, 'maintenance', mid, 'delete', `Deleted maintenance #${mid}`);
}

