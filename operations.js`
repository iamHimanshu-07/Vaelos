const { pool, recomputeLicenseNotifications, writeAudit,
        isDemoEmail, ensureDemoClone, demoFilter } = require('./database');

const now = () => new Date().toISOString();

async function audit(ctx, entity, entity_id, action, message) {
  await writeAudit(ctx?.user || null, entity, entity_id, action, message);
}

// ============================== USERS ============================== //
async function listUsers() {
  const res = await pool.query('SELECT id,name,email,role,created_at FROM users ORDER BY id');
  return res.rows;
}
async function addUser(ctx, { name, email, password, role }) {
  const bcrypt = require('bcryptjs');
  const hash = bcrypt.hashSync(password, 10);
  const res = await pool.query(
    'INSERT INTO users (name,email,password_hash,role,created_at) VALUES ($1,$2,$3,$4,$5) RETURNING id',
    [name.trim(), email.toLowerCase().trim(), hash, role, now()]
  );
  const id = res.rows[0].id;
  await audit(ctx, 'user', id, 'create', `Created user ${email}`);
}
async function deleteUser(ctx, id) {
  const res = await pool.query('SELECT email FROM users WHERE id=$1', [id]);
  const u = res.rows[0];
  await pool.query('DELETE FROM users WHERE id = $1', [id]);
  await audit(ctx, 'user', id, 'delete', `Deleted user ${u?.email}`);
}

// ============================== VEHICLES ============================== //
async function listVehicles(filters = {}, viewerEmail) {
  const f = demoFilter(viewerEmail);
  let q = `SELECT * FROM vehicles WHERE ${f.where}`;
  const args = [...f.args];
  if (filters.type && filters.type !== 'All')   { q += ' AND type = $'+(args.length+1);   args.push(filters.type); }
  if (filters.status && filters.status !== 'All'){q += ' AND status = $'+(args.length+1); args.push(filters.status); }
  if (filters.region && filters.region !== 'All'){q += ' AND region = $'+(args.length+1); args.push(filters.region); }
  q += ' ORDER BY reg_no';

  const res = await pool.query(q, args);
  const vehicles = res.rows;

  // Decorate each vehicle with `current_load_kg`
  const loadArgs = isDemoEmail(viewerEmail) ? f.args : [];
  const loadRes = await pool.query(
    `SELECT vehicle_id, COALESCE(SUM(cargo_kg),0) c
       FROM trips WHERE status='Dispatched' ${isDemoEmail(viewerEmail) ? 'AND _demo_owner = $1' : ''}
       GROUP BY vehicle_id`,
    loadArgs
  );
  const loadMap = Object.fromEntries(loadRes.rows.map(r => [r.vehicle_id, r.c]));
  for (const v of vehicles) v.current_load_kg = loadMap[v.id] || 0;
  return vehicles;
}
async function getVehicle(id) {
  const res = await pool.query('SELECT * FROM vehicles WHERE id = $1', [id]);
  return res.rows[0];
}
async function addVehicle(ctx, { reg_no, name, type, max_load_kg, odometer_km, acquisition_cost, region }) {
  const res = await pool.query(
    `INSERT INTO vehicles
     (reg_no,name,type,max_load_kg,odometer_km,acquisition_cost,region,status,created_at)
     VALUES ($1,$2,$3,$4,$5,$6,$7, 'Available', $8) RETURNING id`,
    [reg_no.toUpperCase().trim(), name.trim(), type, +max_load_kg,
     +odometer_km, +acquisition_cost, region, now()]
  );
  const id = res.rows[0].id;
  await audit(ctx, 'vehicle', id, 'create', `Registered vehicle ${reg_no.toUpperCase()} (${name})`);
}
async function updateVehicle(ctx, id, fields) {
  const allowed = ['name','type','max_load_kg','odometer_km','acquisition_cost','region','status'];
  const sets = []; const args = [];
  for (const k of allowed) { if (k in fields) { sets.push(`${k} = $${args.length + 1}`); args.push(fields[k]); } }
  if (!sets.length) return;
  args.push(id);
  await pool.query(`UPDATE vehicles SET ${sets.join(', ')} WHERE id = $${args.length}`, args);
  await audit(ctx, 'vehicle', id, 'update', `Updated ${Object.keys(fields).join(', ')}`);
}
async function deleteVehicle(ctx, id) {
  const res = await pool.query('SELECT reg_no FROM vehicles WHERE id=$1', [id]);
  const v = res.rows[0];
  await pool.query('DELETE FROM vehicles WHERE id = $1', [id]);
  await audit(ctx, 'vehicle', id, 'delete', `Deleted vehicle ${v?.reg_no}`);
}

