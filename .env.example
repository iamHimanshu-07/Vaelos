# Production environment example.
# Copy these into your Railway service → Variables tab.
#
# REQUIRED on Railway (so SQLite lives on the persistent volume):
VAELOS_DB=/data/vaelos.db
#
# RECOMMENDED (replace the dev secret before going live):
JWT_SECRET=change-me-to-a-long-random-string
#
# OPTIONAL — Railway injects PORT automatically; only set this if you need to override:
# PORT=3000

# ---- Owner notifications ----
# Every signup and every login (non-demo accounts) sends an alert here.
OWNER_EMAIL=itshimanshu666@gmail.com

# Resend API key for the owner-notification transport.
# If unset, alerts are appended to ./outbox.log instead (useful for local dev).
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
VAELOS_FROM=Vaelos Alerts <alerts@vaelos.app>
