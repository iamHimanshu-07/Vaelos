# Production environment example.
# Copy these into your Railway service → Variables tab.
#
# REQUIRED on Railway (so SQLite lives on the persistent volume):
VAELOS_DB=/data/vaelos.db
#
# RECOMMENDED (replace the dev secret before going live):
JWT_SECRET=change-me-to-a-long-random-string
#
# OPTIONAL — Railway injects PORT automatically; only set this if you need to override:
# PORT=3000
