# Force-override any inherited production / NODE_ENV=production setting.
# The deprecated `production=true` key (and `NODE_ENV=production` which npm
# infers as production) cause this build warning:
#   "npm warn config production Use omit=dev instead"
# Setting `omit=` (empty) tells npm to install ALL deps (including dev),
# which is what we want for a fresh build on Railway.
omit=
fund=false
audit=false
